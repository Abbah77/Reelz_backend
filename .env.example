# Reelz — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Auth (X-Reelz-Token header) ───────────────────────────────────────────────
APP_SECRET_TOKEN=your-secret-token-here

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── Cache ─────────────────────────────────────────────────────────────────────
# Options: memory | redis | cloudflare
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=480
REDIS_URL=redis://localhost:6379

# Cloudflare KV (only if CACHE_BACKEND=cloudflare)
CF_KV_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_KV_API_TOKEN=

# ── WARP ──────────────────────────────────────────────────────────────────────
# Options: off | required | fallback | all
WARP_MODE=off
WARP_PROXY_URL=socks5://localhost:1080
WARP_FLARESOLVERR_URL=http://localhost:8191

# ── FlareSolverr ──────────────────────────────────────────────────────────────
FLARESOLVERR_URL=http://localhost:8191

# ── Captcha ───────────────────────────────────────────────────────────────────
ANTICAPTCHA_KEY=
TWOCAPTCHA_KEY=

# ── Residential IP ────────────────────────────────────────────────────────────
RESIDENTIAL_PROXY_URL=

# ── Debrid ────────────────────────────────────────────────────────────────────
REALDEBRID_KEY=
ALLDEBRID_KEY=
TORBOX_KEY=

# ── Provider tuning ───────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_MS=45000
CB_FAIL_THRESHOLD=2
CB_COOLDOWN_SECONDS=300
PROVIDER_STATS_FILE=./provider-stats.json

# ── Provider-specific ─────────────────────────────────────────────────────────
CASTLE_SUFFIX=
HDREZKA_BASE_URL=https://rezka.ag
ANIZONE_BASE_URL=https://anizone.to
WYZIE_KEY=
CONSUMET_URL=
