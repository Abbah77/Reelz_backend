# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=false

# ── TMDB ───────────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_key_here

# ── Cache ──────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=480          # 8 minutes — safe before stream tokens expire
# REDIS_URL=redis://localhost:6379   # Uncomment to switch from memory to Redis

# ── FlareSolverr (Cloudflare bypass) ──────────────────────────────────────────
# FLARESOLVERR_URL=http://localhost:8191   # comma-separated for round-robin

# ── WARP IP Rotation ───────────────────────────────────────────────────────────
# Modes: off | required | fallback | all
WARP_MODE=off
# WARP_PROXY_URL=socks5://127.0.0.1:1080
# WARP_FLARESOLVERR_URL=http://127.0.0.1:8191

# ── Provider tuning ────────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_MS=45000

# ── Circuit breaker ────────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAIL_THRESHOLD=4
CIRCUIT_BREAKER_COOLDOWN_S=600
PROVIDER_STATS_FILE=./provider-stats.json

# ── Indian providers ───────────────────────────────────────────────────────────
# CASTLE_SUFFIX=tv   # e.g. "tv" → https://castletv.com

# ── Anime ──────────────────────────────────────────────────────────────────────
# ANIZONE_BASE_URL=https://anizone.to
# ANIMEPARHE_BASE_URL=https://animepahe.pw

# ── Subtitles ──────────────────────────────────────────────────────────────────
# WYZIE_KEY=your_key_here

# ── Debrid ─────────────────────────────────────────────────────────────────────
# REALDEBRID_KEY=
# ALLDEBRID_KEY=
# TORBOX_KEY=

# ── HDRezka ────────────────────────────────────────────────────────────────────
# HDREZKA_BASE_URL=https://rezka.ag

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
