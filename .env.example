# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=false

# ── TMDB ─────────────────────────────────────────────────────────────────────
TMDB_API_KEY=b8f51b5206d37dbda94f6bab13ee2d38

# ── FlareSolverr ─────────────────────────────────────────────────────────────
# Comma-separated list of FlareSolverr endpoints (round-robin'd)
# FLARESOLVERR_URL=http://localhost:8191

# ── WARP IP Rotation ─────────────────────────────────────────────────────────
# Cloudflare WARP gives your server a clean residential egress IP.
# Many providers (AnimePahe, Kwik, some Indian CDNs) block datacenter IPs.
#
# Mode options:
#   off       - never use WARP (default)
#   required  - only providers that declare requires_warp=True use it
#   fallback  - try plain first; if provider returns nothing, retry via WARP
#   all       - route every provider request through WARP
#
WARP_MODE=off

# SOCKS5 proxy for direct outbound requests (comma-separated for multiple pairs)
# Setup: https://github.com/cmj2002/warp-docker
# WARP_PROXY_URL=socks5://127.0.0.1:1080

# FlareSolverr instance whose container egresses via WARP (comma-separated)
# Use this to unblock providers that check IP at the CF challenge step
# WARP_FLARESOLVERR_URL=http://127.0.0.1:8191

# ── Source Cache ─────────────────────────────────────────────────────────────
# In-memory cache for resolved SSE events.
# Repeat opens of the same title within TTL replay instantly (< 100ms).
# Increase MAX if you serve many concurrent users with diverse content.
CACHE_TTL_SECONDS=480       # 8 minutes — safe window before stream tokens expire
# CACHE_MAX_ENTRIES=500     # hardcoded in source_cache.py, change there if needed

# ── Provider tuning ───────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_MS=45000

# ── Circuit breaker ───────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAIL_THRESHOLD=4
CIRCUIT_BREAKER_COOLDOWN_S=600
PROVIDER_STATS_FILE=./provider-stats.json

# ── Subtitles ─────────────────────────────────────────────────────────────────
# WYZIE_KEY=

# ── Anime ─────────────────────────────────────────────────────────────────────
# ANIZONE_BASE_URL=https://anizone.to
# ANIMEPARHE_BASE_URL=https://animepahe.pw

# ── Debrid ────────────────────────────────────────────────────────────────────
# REALDEBRID_KEY=
# ALLDEBRID_KEY=
# TORBOX_KEY=

# ── Torrent streaming ─────────────────────────────────────────────────────────
TORRENT_ENABLED=false
TORRENT_DIR=/tmp/reelz-torrents

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
