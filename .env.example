# ─────────────────────────────────────────────────────────────────────────────
# Reelz Backend — Environment Variables
# Copy this file to .env and fill in the values before deploying.
# On Render: set these in Dashboard → Your Service → Environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── App authentication (Section 3.3) ─────────────────────────────────────────
# Shared secret — sent by Android app as X-Reelz-Token header on every request.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotate via remote config (config.json backend.app_token) + this env var.
APP_SECRET_TOKEN=your-random-64-char-string-here

# ── Paystack (Section 9.1) ────────────────────────────────────────────────────
# Secret key from Paystack Dashboard → Settings → API Keys & Webhooks.
# Used ONLY to validate HMAC-SHA512 webhook signatures. Never sent to clients.
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here

# ── Redis (Section 3.4) ───────────────────────────────────────────────────────
# Add a Redis service in Render dashboard, copy the Internal Redis URL here.
# Without this, the app uses in-memory cache which resets on every restart.
REDIS_URL=redis://your-redis-internal-url:6379

# ── Workers (Section 3.5) ─────────────────────────────────────────────────────
# Do not exceed 2 on Render free/starter (RAM limit).
# Increase to 4 when you move to Hetzner.
WORKERS=2

# ── TMDB (set automatically via remote config on the Android side) ────────────
# Backend uses its own TMDB key only for enrichment (genre/anime detection).
TMDB_API_KEY=your_tmdb_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your domain in production. "*" is fine while testing.
CORS_ORIGINS=*

# ── Debug ─────────────────────────────────────────────────────────────────────
# Leave blank in production.
DEBUG_TOKEN=
