# Reelz — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Auth (X-Reelz-Token header — sent by the app on ENGINE routes) ────────────
APP_SECRET_TOKEN=your-secret-token-here

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_POSTER_SIZE=w500
TMDB_BACKDROP_SIZE=w1280
TMDB_STILL_SIZE=w300
TMDB_PROFILE_SIZE=w185

# ── Cache ─────────────────────────────────────────────────────────────────────
# Options: memory | redis | cloudflare
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=480
REDIS_URL=redis://localhost:6379

# Cloudflare KV (only if CACHE_BACKEND=cloudflare)
CF_KV_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_KV_API_TOKEN=

# ── WARP ──────────────────────────────────────────────────────────────────────
# Options: off | required | fallback | all
WARP_MODE=off
WARP_PROXY_URL=socks5://localhost:1080
WARP_FLARESOLVERR_URL=http://localhost:8191

# ── FlareSolverr ──────────────────────────────────────────────────────────────
FLARESOLVERR_URL=http://localhost:8191

# ── Captcha ───────────────────────────────────────────────────────────────────
ANTICAPTCHA_KEY=
TWOCAPTCHA_KEY=

# ── Residential IP ────────────────────────────────────────────────────────────
RESIDENTIAL_PROXY_URL=

# ── Debrid ────────────────────────────────────────────────────────────────────
REALDEBRID_KEY=
ALLDEBRID_KEY=
TORBOX_KEY=

# ── Provider tuning ───────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_MS=45000
CB_FAIL_THRESHOLD=2
CB_COOLDOWN_SECONDS=300
PROVIDER_STATS_FILE=./provider-stats.json

# ── Provider-specific ─────────────────────────────────────────────────────────
CASTLE_SUFFIX=
HDREZKA_BASE_URL=https://rezka.ag
ANIZONE_BASE_URL=https://anizone.to
WYZIE_KEY=
CONSUMET_URL=

# ── JWT (your own tokens, issued after Google auth) ───────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_HOURS=720

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Your Firebase/Google OAuth2 Web Client ID (from Google Cloud Console).
# Leave empty to skip audience validation (dev only).
GOOGLE_CLIENT_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev / small single-VPS prod):
DATABASE_URL=sqlite+aiosqlite:///./reelz.db
# Postgres (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reelz

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret
PAYSTACK_BASE_URL=https://api.paystack.co

# ── App Config (returned by GET /config) ─────────────────────────────────────
APP_VERSION=1
MIN_APP_VERSION=1
LATEST_APP_VERSION=1
LATEST_APK_URL=

# Feature flags
SHORTS_ENABLED=true
DOWNLOADS_ENABLED=true
FORCE_MAINTENANCE=false
MAINTENANCE_MESSAGE=

# Premium pricing
PREMIUM_ENABLED=false
PREMIUM_MONTHLY_PRICE=200000
PAYSTACK_MONTHLY_URL=
PAYSTACK_YEARLY_URL=

# Ads (AppLovin MAX or similar)
ADS_ENABLED=false
APPLOVIN_SDK_KEY=
ADS_MEDIATION_PROVIDER=max
ADS_BANNER_ID=
ADS_INTERSTITIAL_ID=
ADS_REWARDED_ID=
ADS_NATIVE_ID=
ADS_APP_OPEN_ID=
ADS_VAST_TAG_URL=
